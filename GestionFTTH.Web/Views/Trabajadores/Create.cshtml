@model GestionFTTH.Web.Models.Trabajador
@using GestionFTTH.Web.Models

@{
    ViewData["Title"] = "Nuevo trabajador";
}

<div class="container-fluid">

    <div class="mb-4">
        <h2 class="fw-bold mb-1" style="color:#12395e;">
            Nuevo trabajador
        </h2>
        <p class="text-muted">
            Registro de personal para proyectos FTTH
        </p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <form asp-controller="Trabajadores"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row g-3">

                    <!-- Código automático -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            Código
                        </label>
                        <input class="form-control"
                               value="Se generará automáticamente"
                               disabled />
                    </div>

                    <!-- Nombres -->
                    <div class="col-md-8">
                        <label asp-for="Nombres"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="Nombres"
                               class="form-control"
                               placeholder="Ingrese los nombres" />

                        <span asp-validation-for="Nombres"
                              class="text-danger"></span>
                    </div>

                    <!-- Apellidos -->
                    <div class="col-md-12">
                        <label asp-for="Apellidos"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="Apellidos"
                               class="form-control"
                               placeholder="Ingrese los apellidos" />

                        <span asp-validation-for="Apellidos"
                              class="text-danger"></span>
                    </div>

                    <!-- Área -->
                    <div class="col-md-6">
                        <label asp-for="Area"
                               class="form-label fw-semibold">
                        </label>

                        <select asp-for="Area"
                                asp-items="Html.GetEnumSelectList<AreaProyecto>()"
                                class="form-select">
                            <option value="">
                                -- Seleccione un área --
                            </option>
                        </select>

                        <span asp-validation-for="Area"
                              class="text-danger"></span>
                    </div>

                    <!-- Cargo -->
                    <div class="col-md-6">
                        <label asp-for="Cargo"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="Cargo"
                               class="form-control"
                               placeholder="Ej. Técnico de campo" />

                        <span asp-validation-for="Cargo"
                              class="text-danger"></span>
                    </div>

                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">

                    <a asp-controller="Trabajadores"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>


                    <button type="submit"
                            class="btn btn-primary">
                        Guardar trabajador
                    </button>


                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
