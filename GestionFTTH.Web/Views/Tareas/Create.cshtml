@model GestionFTTH.Web.Models.Tarea

@using GestionFTTH.Web.Models
@using Microsoft.AspNetCore.Mvc.Rendering
@using GestionFTTH.Web.Data

@{
    ViewData["Title"] = "Nueva tarea";

    var proyectos = ViewBag.Proyectos as List<Proyecto>
                    ?? new List<Proyecto>();

    var listaProyectos = proyectos.Select(p =>
        new SelectListItem
        {
            Value = p.Id.ToString(),
            Text = $"{p.Codigo} - {p.Nombre}"
        }).ToList();

    var trabajadores = ViewBag.Trabajadores
        as List<ApplicationUser>
        ?? new List<ApplicationUser>();

    var listaTrabajadores = trabajadores.Select(u =>
        new SelectListItem
        {
            Value = u.Id,
            Text = u.UserName ?? u.Email ?? u.Id
        }).ToList();

}

<div class="container-fluid">

    <div class="mb-4">
        <h2 class="fw-bold mb-1" style="color:#12395e;">
            Nueva tarea
        </h2>

        <p class="text-muted">
            Registro de actividades asociadas a proyectos FTTH
        </p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <form asp-controller="Tareas"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row g-3">

                    <!-- Proyecto -->
                    <div class="col-md-12">
                        <label asp-for="ProyectoId"
                               class="form-label fw-semibold">
                        </label>

                        <select asp-for="ProyectoId"
                                asp-items="listaProyectos"
                                class="form-select">
                            <option value="">
                                -- Seleccione un proyecto --
                            </option>
                        </select>

                        <span asp-validation-for="ProyectoId"
                              class="text-danger"></span>
                    </div>

                    <!-- Responsable -->
                    <div class="col-md-12">
                        <label asp-for="ResponsableId"
                               class="form-label fw-semibold">
                            Responsable asignado
                        </label>

                        <select asp-for="ResponsableId"
                                asp-items="listaTrabajadores"
                                class="form-select">
                            <option value="">
                                -- Seleccione un trabajador --
                            </option>
                        </select>

                        <span asp-validation-for="ResponsableId"
                              class="text-danger"></span>
                    </div>

                    <!-- Código -->
                    <div class="col-md-4">
                        <label asp-for="Codigo"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="Codigo"
                               class="form-control"
                               placeholder="Ej. T001" />

                        <span asp-validation-for="Codigo"
                              class="text-danger"></span>
                    </div>

                    <!-- Título -->
                    <div class="col-md-8">
                        <label asp-for="Titulo"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="Titulo"
                               class="form-control"
                               placeholder="Ej. Levantamiento de campo" />

                        <span asp-validation-for="Titulo"
                              class="text-danger"></span>
                    </div>

                    <!-- Descripción -->
                    <div class="col-md-12">
                        <label asp-for="Descripcion"
                               class="form-label fw-semibold">
                        </label>

                        <textarea asp-for="Descripcion"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Describa la actividad">
                        </textarea>

                        <span asp-validation-for="Descripcion"
                              class="text-danger"></span>
                    </div>

                    <!-- Prioridad -->
                    <div class="col-md-6">
                        <label asp-for="Prioridad"
                               class="form-label fw-semibold">
                        </label>

                        <select asp-for="Prioridad"
                                asp-items="Html.GetEnumSelectList<PrioridadTarea>()"
                                class="form-select">
                        </select>
                    </div>

                    <!-- Estado -->
                    <div class="col-md-6">
                        <label asp-for="Estado"
                               class="form-label fw-semibold">
                        </label>

                        <select asp-for="Estado"
                                asp-items="Html.GetEnumSelectList<EstadoTarea>()"
                                class="form-select">
                        </select>
                    </div>

                    <!-- Fecha de inicio -->
                    <div class="col-md-6">
                        <label asp-for="FechaInicio"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="FechaInicio"
                               type="date"
                               class="form-control" />
                    </div>

                    <!-- Fecha límite -->
                    <div class="col-md-6">
                        <label asp-for="FechaLimite"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="FechaLimite"
                               type="date"
                               class="form-control" />
                    </div>

                    <!-- Avance -->
                    <div class="col-md-6">
                        <label asp-for="PorcentajeAvance"
                               class="form-label fw-semibold">
                        </label>

                        <div class="input-group">
                            <input asp-for="PorcentajeAvance"
                                   type="number"
                                   min="0"
                                   max="100"
                                   class="form-control" />

                            <span class="input-group-text">%</span>
                        </div>

                        <span asp-validation-for="PorcentajeAvance"
                              class="text-danger"></span>
                    </div>

                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">

                    <a asp-controller="Tareas"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        Guardar tarea
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
