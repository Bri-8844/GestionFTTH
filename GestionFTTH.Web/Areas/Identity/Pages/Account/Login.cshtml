@page
@model LoginModel

@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />
    <title>Gestión FTTH | Iniciar sesión</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
        :root {
            --azul: #123B70;
            --azul-principal: #0864BD;
            --celeste: #0EA5E9;
            --verde: #10B981;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Segoe UI', Arial, sans-serif;
            background: #eef5fb;
        }

        .login-container {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 1fr 1fr;
        }

        .login-info {
            background: linear-gradient(
                145deg, #06264a, #075b9d 75%, #0b92aa);
            color: white;
            padding: 65px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }

        .login-info::before {
            content: "";
            position: absolute;
            width: 350px;
            height: 350px;
            border-radius: 50%;
            background: rgba(16,185,129,.18);
            top: -180px;
            right: -150px;
        }

        .login-info h1 {
            font-size: clamp(30px, 3vw, 48px);
            font-weight: 750;
            line-height: 1.2;
            max-width: 620px;
        }

        .login-info p {
            color: #d5eaf9;
            font-size: 18px;
            max-width: 540px;
            margin-top: 25px;
        }

        .linea-verde {
            width: 85px;
            height: 5px;
            background: var(--verde);
            border-radius: 10px;
            margin-top: 25px;
        }

        .areas {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 45px;
        }

        .area {
            padding: 20px 15px;
            border: 1px solid rgba(255,255,255,.25);
            border-radius: 14px;
            background: rgba(255,255,255,.1);
            font-size: 13px;
            font-weight: 700;
            text-align: center;
            flex: 1;
            min-width: 125px;
        }

        .login-form-container {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 35px;
            background: linear-gradient(145deg,#eaf5ff,#ffffff);
        }

        .login-card {
            width: 100%;
            max-width: 470px;
            padding: 45px;
            background: white;
            border-radius: 24px;
            box-shadow: 0 15px 50px rgba(18,59,112,.12);
        }

        .logo {
            text-align: center;
            margin-bottom: 35px;
        }

        .logo-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 65px;
            height: 65px;
            background: linear-gradient(135deg,#0874d1,#10b981);
            color: white;
            border-radius: 17px;
            font-size: 25px;
            font-weight: bold;
            margin-bottom: 12px;
        }

        .logo h2 {
            color: var(--azul);
            font-weight: 800;
            margin: 0;
        }

        .logo span {
            font-size: 12px;
            letter-spacing: 2px;
            color: #64748b;
        }

        .login-title {
            text-align: center;
            color: #122a4b;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .login-subtitle {
            text-align: center;
            color: #64748b;
            margin-bottom: 30px;
        }

        .form-label {
            color: #334155;
            font-weight: 600;
        }

        .form-control {
            padding: 13px;
            border-radius: 10px;
            border: 1px solid #cbd5e1;
        }

        .form-control:focus {
            border-color: var(--celeste);
            box-shadow: 0 0 0 3px rgba(14,165,233,.12);
        }

        .btn-login {
            width: 100%;
            padding: 14px;
            background: linear-gradient(90deg,#0756a4,#087ed2);
            border: none;
            border-radius: 10px;
            color: white;
            font-size: 16px;
            font-weight: 700;
            transition: .2s;
        }

        .btn-login:hover {
            background: #064987;
            color: white;
        }

        .forgot-link {
            color: #0864bd;
            text-decoration: none;
            font-size: 14px;
        }

        .footer-login {
            text-align: center;
            margin-top: 30px;
            color: #94a3b8;
            font-size: 12px;
        }

        @@media (max-width: 850px) {
            .login-container {
                grid-template-columns: 1fr;
            }

            .login-info {
                padding: 35px 25px;
            }

            .login-info h1 {
                font-size: 28px;
            }

            .login-info p {
                font-size: 15px;
            }

            .areas {
                margin-top: 20px;
            }

            .login-form-container {
                padding: 25px 15px;
            }

            .login-card {
                padding: 30px 22px;
            }
        }
    </style>
</head>

<body>
    <main class="login-container">

        <section class="login-info">
            <h1>
                Sistema de Gestión y Monitoreo
                de Proyectos y Tareas
            </h1>

            <div class="linea-verde"></div>

            <p>
                Planifica, asigna, supervisa y controla
                el avance de tus proyectos de
                telecomunicaciones desde una
                plataforma centralizada.
            </p>

            <div class="areas">
                <div class="area">PREDISEÑO</div>
                <div class="area">DISEÑO</div>
                <div class="area">CONSTRUCCIÓN</div>
            </div>
        </section>

        <section class="login-form-container">
            <div class="login-card">

                <div class="logo">
                    <div class="logo-icon">FTTH</div>
                    <h2>Gestión FTTH</h2>
                    <span>GESTIÓN DE PROYECTOS</span>
                </div>

                <h3 class="login-title">Iniciar sesión</h3>
                <p class="login-subtitle">
                    Ingresa tus credenciales para continuar
                </p>

                <form id="account" method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"
                         role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Email"
                               class="form-label">
                            Correo electrónico
                        </label>

                        <input asp-for="Input.Email"
                               class="form-control"
                               autocomplete="username"
                               placeholder="usuario@empresa.com"
                               aria-required="true" />

                        <span asp-validation-for="Input.Email"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password"
                               class="form-label">
                            Contraseña
                        </label>

                        <input asp-for="Input.Password"
                               class="form-control"
                               autocomplete="current-password"
                               placeholder="Ingresa tu contraseña"
                               aria-required="true" />

                        <span asp-validation-for="Input.Password"
                              class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between
                                align-items-center mb-4">

                        <label class="form-check-label">
                            <input asp-for="Input.RememberMe"
                                   class="form-check-input" />
                            Recordarme
                        </label>

                        <a asp-page="./ForgotPassword"
                           class="forgot-link">
                            ¿Olvidaste tu contraseña?
                        </a>
                    </div>

                    <button id="login-submit"
                            type="submit"
                            class="btn-login">
                        Ingresar al sistema
                    </button>
                </form>

                <div class="footer-login">
                    © 2026 Gestión FTTH
                    <p>Acceso exclusivo para personal autorizado</p>
                </div>
            </div>
        </section>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
